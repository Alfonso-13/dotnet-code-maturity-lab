@page "/en-preparacion/{Section}"
@inject NavigationManager Navigation

<PageTitle>@Content.Title en preparación | .NET Code Maturity Lab</PageTitle>

<section class="maintenance-page">
    <div class="maintenance-copy">
        <span class="eyebrow">Contenido en proceso</span>
        <h1>@Content.Title todavía no está disponible.</h1>
        <p>@Content.Description</p>

        <div class="maintenance-status" aria-label="Estado del contenido">
            <div><span>Estado</span><strong>Definición y diseño</strong></div>
            <div class="maintenance-track"><span></span></div>
            <small>Se publicará cuando el recorrido y sus ejemplos estén completos.</small>
        </div>

        <div class="button-row">
            <a class="button button-primary" href="laboratorio">Continuar con Junior <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="ruta">Ver ruta de madurez</a>
        </div>
    </div>

    <div class="maintenance-visual" aria-hidden="true">
        <span class="maintenance-number">@Content.Number</span>
        <div class="maintenance-lines"><i></i><i></i><i></i></div>
        <strong>En construcción</strong>
        <small>@Content.Title</small>
    </div>
</section>

@code {
    [Parameter] public string Section { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (Section.Equals("laboratorio-junior", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/laboratorio/junior", replace: true);
        }
    }

    private MaintenanceContent Content => Section.ToLowerInvariant() switch
    {
        "arquitectura" => new("04", "Arquitectura", "Aquí se explicarán límites, capas, dependencias y decisiones de solución después de completar la base Junior y Middle."),
        "azure" => new("05", "Azure y escala", "Aquí se visualizarán recursos de Microsoft Azure, costos, escalamiento vertical, horizontal y automático, junto con sus límites reales."),
        "glosario" => new("06", "Glosario", "Las definiciones se publicarán conforme cada concepto tenga un ejemplo verificable dentro del laboratorio."),
        "solid" => new("S", "Ejemplo SOLID", "SOLID se desarrollará en el nivel Middle, donde podremos mostrar el problema, la refactorización y las consecuencias de cada decisión."),
        _ => new("…", "Esta sección", "Estamos definiendo el contenido y su demostración antes de publicarlo.")
    };

    private sealed record MaintenanceContent(string Number, string Title, string Description);
}
