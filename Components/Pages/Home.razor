@page "/"
@inherits LocalizedComponentBase

<PageTitle>@T("Home", "Inicio") | .NET Code Maturity Lab</PageTitle>

<section class="hero page-section reveal-section">
    <div class="hero-copy">
        <span class="eyebrow">@T("Interactive laboratory · .NET 10", "Laboratorio interactivo · .NET 10")</span>
        <h1>@T("Learn .NET through visual code and real decisions.", "Aprende .NET con código visual y decisiones reales.")</h1>
        <p class="lead">@T("Master .NET through visual comparisons, executable examples, and real engineering decisions. Progress from C# fundamentals to architecture, operations, and scalability.", "Domina .NET con comparaciones visuales, ejemplos ejecutables y decisiones reales. Avanza desde los fundamentos de C# hasta arquitectura, operación y escalabilidad.")</p>
        <div class="button-row">
            <a class="button button-primary" href="ruta">@T("Start learning", "Empezar a aprender") <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="laboratorio">@T("Practice in laboratories", "Practicar en laboratorios")</a>
        </div>
        <div class="hero-meta">
            <span><strong>3</strong> @T("maturity levels", "niveles de madurez")</span><span><strong>1</strong> @T("evolving API", "API que evoluciona")</span><span><strong>0</strong> @T("registration required", "registro requerido")</span>
        </div>
    </div>
    <div class="hero-visual" aria-label="@T("Order API code evolving from Junior to Senior", "Código de una API de órdenes que evoluciona de Junior a Senior")">
        <div class="terminal-bar"><span></span><span></span><span></span><small>order-processing.cs</small></div>
        <div class="maturity-code" aria-label="Ejemplo de código C# correctamente indentado">
            <span class="line-number">01</span><code><b>public async</b> Task&lt;Result&gt; Process(Order order)</code>
            <span class="line-number">02</span><code>{</code>
            <span class="line-number">03</span><code class="code-indent-1"><mark>Validate(order);</mark></code>
            <span class="line-number">04</span><code class="code-indent-1"><b>var</b> saved = <b>await</b> PersistAsync(order);</code>
            <span class="line-number">05</span><code class="code-indent-1"><b>return</b> Result.Success(saved);</code>
            <span class="line-number">06</span><code>}</code>
        </div>
        <div class="level-stack">
            <div><span class="stack-icon" aria-hidden="true">✓</span><strong>Junior</strong><small>@T("Solves correctly", "Resuelve correctamente")</small></div>
            <div><span class="stack-icon" aria-hidden="true">◇</span><strong>Middle</strong><small>@T("Designs for change", "Diseña para el cambio")</small></div>
            <div><span class="stack-icon" aria-hidden="true">◆</span><strong>Senior</strong><small>@T("Operates in production", "Opera en producción")</small></div>
        </div>
    </div>
</section>

<section class="page-section section-heading reveal-section">
    <div><span class="eyebrow">@T("Learn by observing and doing", "Aprende observando y haciendo")</span><h2>@T("See the problem. Compare options. Verify the decision.", "Ve el problema. Compara opciones. Comprueba la decisión.")</h2></div>
    <p>@T("Concepts are explained through code, visual walkthroughs, and short exercises so you understand when to apply each practice and how to defend it in an interview.", "Los conceptos se explican con código, recorridos visuales y ejercicios breves para que entiendas cuándo aplicar cada práctica y cómo defenderla en una entrevista.")</p>
</section>

<section class="feature-grid page-section reveal-section" aria-label="@T("How learning works in the laboratory", "Cómo se aprende en el laboratorio")">
    <article class="feature-card feature-compare"><div class="feature-illustration"><img src="images/learning-compare.svg" alt="@T("Before-and-after code with risks and responsibilities highlighted", "Código antes y después con riesgos y responsabilidades señaladas")" /></div><h3>@T("Compare", "Compara")</h3><p>@T("Contrast fragile code with a clearer solution. Identify coupling, mixed responsibilities, and decisions that make change harder.", "Contrasta código frágil contra una solución más clara. Identifica acoplamiento, responsabilidades mezcladas y decisiones que dificultan el cambio.")</p><span class="text-link">@T("Before, after, and why", "Antes, después y por qué") →</span></article>
    <article class="feature-card feature-experiment"><div class="feature-illustration"><img src="images/learning-experiment.svg" alt="@T("Test panel connected to an API request", "Panel de pruebas conectado con una petición a la API")" /></div><h3>@T("Experiment", "Experimenta")</h3><p>@T("Change data, run tests, and trigger controlled errors. Observe what happens in the service, API, and HTTP response.", "Cambia datos, ejecuta pruebas y provoca errores controlados. Observa qué ocurre en el servicio, la API y la respuesta HTTP.")</p><span class="text-link">@T("Tests and behavior", "Pruebas y comportamiento") →</span></article>
    <article class="feature-card feature-decide"><div class="feature-illustration"><img src="images/learning-decide.svg" alt="@T("Decision flow with simple and scalable alternatives", "Flujo de decisiones con alternativas simples y escalables")" /></div><h3>@T("Decide", "Decide")</h3><p>@T("Relate each alternative to its cost, risk, and context. Learn when a simple solution is enough and when the design must scale.", "Relaciona cada alternativa con su costo, riesgo y contexto. Aprende cuándo una solución sencilla basta y cuándo necesitas escalar el diseño.")</p><span class="text-link">@T("Context and trade-offs", "Contexto y trade-offs") →</span></article>
</section>

<section class="path-preview page-section reveal-section">
    <div class="section-heading compact"><div><span class="eyebrow">@T("Learning path", "Ruta de aprendizaje")</span><h2>@T("Learn .NET visually, from fundamentals to production.", "Aprende .NET visualmente, desde los fundamentos hasta producción.")</h2></div><a class="text-link" href="ruta">@T("Explore the roadmap", "Explorar la ruta") →</a></div>
    <div class="path-scroll" aria-label="@T("Path from Junior to Senior", "Ruta de Junior a Senior")">
        <div class="path-line">
            <div class="maturity-rail rail-junior-middle" aria-hidden="true"><span></span></div>
            <div class="maturity-rail rail-middle-senior" aria-hidden="true"><span></span></div>
            <article class="path-junior"><div class="level-person level-badge" role="img" aria-label="Red and Black Codeworkers Junior badge"></div><span class="level-stage">@T("Start here", "Comienza aquí")</span><h3>Junior</h3><p>@T("Build a solid foundation with C#, OOP, collections, LINQ, async programming, validation, REST, and AAA unit tests.", "Construye una base sólida con C#, POO, colecciones, LINQ, asincronía, validación, REST y pruebas unitarias con AAA.")</p><strong>@T("Make it work correctly.", "Haz que funcione correctamente.")</strong></article>
            <article class="path-middle"><div class="level-person level-badge" role="img" aria-label="Red and Black Codeworkers Mid badge"></div><span class="level-stage">@T("Design better", "Diseña mejor")</span><h3>Middle</h3><p>@T("Refactor with SOLID, dependency injection, and Strategy. Separate responsibilities and verify real collaborations.", "Refactoriza con SOLID, inyección de dependencias y Strategy. Separa responsabilidades y comprueba colaboraciones reales.")</p><strong>@T("Make it maintainable.", "Haz que sea mantenible.")</strong></article>
            <article class="path-senior"><div class="level-person level-badge" role="img" aria-label="Red and Black Codeworkers Senior badge"></div><span class="level-stage">@T("Operate with confidence", "Opera con confianza")</span><h3>Senior</h3><p>@T("Protect the solution with idempotency, concurrency, resilience, observability, security, and Azure scaling strategies.", "Protege la solución con idempotencia, concurrencia, resiliencia, observabilidad, seguridad y estrategias de escala en Azure.")</p><strong>@T("Make it withstand production.", "Haz que resista producción.")</strong></article>
        </div>
    </div>
</section>
