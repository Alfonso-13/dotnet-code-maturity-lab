@page "/roadmap"
@page "/ruta"
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageTitle>@T("Maturity roadmap", "Ruta de madurez") | .NET Code Maturity Lab</PageTitle>

<header class="maturity-map-intro">
    <span class="eyebrow">@T("Maturity roadmap", "Ruta de madurez")</span>
    <h1>@T("One API. Three engineering levels.", "Una API. Tres niveles de ingeniería.")</h1>
    <p>@T("Learn how a solution moves from working correctly to becoming maintainable and finally withstanding real production conditions.", "Aprende cómo una solución pasa de funcionar correctamente a ser mantenible y finalmente resistir condiciones reales de producción.")</p>
</header>

<section class="maturity-map" aria-label="@T("Learning map by level", "Mapa de aprendizaje por niveles")">
    <header class="maturity-map-header">
        <div><span>@T("Your journey", "Tu recorrido")</span><strong>@LearningLevelCatalog.TotalModuleCount @T("modules", "módulos") · @Levels.Count @T("capstone laboratories", "laboratorios integradores")</strong></div>
        <span class="maturity-current">@ActiveLevel.Label · @ActiveLevel.Stage.Get(Language.Current)</span>
    </header>

    <div class="maturity-level-selector" role="group" aria-label="@T("Select a level", "Selecciona un nivel")">
        @foreach (var level in Levels)
        {
            var completed = CompletedModules(level);
            var progress = Progress(level);
            <button type="button" class="maturity-level-card @level.Key @(level.Key == SelectedLevel ? "active" : null)" aria-pressed="@(level.Key == SelectedLevel ? "true" : "false")" @onclick="() => SelectLevel(level.Key)">
                <span class="maturity-level-badge" aria-hidden="true"></span>
                <span class="maturity-level-copy"><small>@level.Stage.Get(Language.Current)</small><strong>@level.Label</strong><span>@level.Verb.Get(Language.Current)</span></span>
                <span class="maturity-level-progress"><i><b style="width:@(progress)%"></b></i><small>@completed @T("of", "de") @level.Modules.Count @T("modules", "módulos")</small></span>
            </button>
        }
    </div>

    <div class="maturity-module-heading">
        <div><small>@ActiveLevel.Label</small><h2>@ActiveLevel.Goal.Get(Language.Current)</h2></div>
        <span>@CompletedModules(ActiveLevel) / @ActiveLevel.Modules.Count @T("completed", "completados")</span>
    </div>

    <div class="maturity-module-grid">
        @foreach (var module in ActiveLevel.Modules)
        {
            var state = ModuleState(ActiveLevel, module);
            <a class="maturity-module @StateClass(state)" href="@ModuleRoute(ActiveLevel, module)">
                <span class="maturity-module-icon" aria-hidden="true">@module.Icon</span>
                <span><strong>@module.Title.Get(Language.Current)</strong><small>@StateLabel(state)</small></span>
                <span class="maturity-module-arrow" aria-hidden="true">→</span>
            </a>
        }
    </div>

    <a class="maturity-lab-card @(IsLabCompleted ? "completed" : null)" href="@ActiveLevel.LabRoute">
        <img src="images/dotnet-code-maturity-lab-icon.png" alt="" />
        <span><small>@T("Laboratory", "Laboratorio") @ActiveLevel.Label</small><strong>@ActiveLevel.LabTitle.Get(Language.Current)</strong><span>@ActiveLevel.LabDescription.Get(Language.Current)</span></span>
        <b>@LabStateLabel</b>
    </a>
</section>

@code {
    private string SelectedLevel { get; set; } = "junior";
    private HashSet<string> Viewed { get; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> Reviewed { get; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> Completed { get; } = new(StringComparer.OrdinalIgnoreCase);

    private LearningLevelDefinition ActiveLevel => Levels.First(level => level.Key == SelectedLevel);

    private static IReadOnlyList<LearningLevelDefinition> Levels => LearningLevelCatalog.Levels;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<LearningProgressState?>("labProgress.get", LearningProgress.StorageKey);
        var progress = LearningProgress.Migrate(stored);
        Viewed.UnionWith(progress.Viewed ?? []);
        Reviewed.UnionWith(progress.Reviewed ?? []);
        Completed.UnionWith(progress.Completed ?? []);
        if ((stored?.Version ?? 0) < LearningProgress.CurrentVersion)
        {
            await JS.InvokeVoidAsync("labProgress.set", LearningProgress.StorageKey, progress);
        }

        StateHasChanged();
    }

    private void SelectLevel(string level) => SelectedLevel = level;
    private int CompletedModules(LearningLevelDefinition level) => level.Modules.Count(module => module.Slugs.All(slug => Completed.Contains(LearningProgress.Entry(level.Key, slug))));
    private int Progress(LearningLevelDefinition level) => (int)Math.Round(CompletedModules(level) * 100d / level.Modules.Count);
    private bool IsLabCompleted => ActiveLevel.IsAvailable
        && Completed.Contains(LearningProgress.Entry(ActiveLevel.Key, ActiveLevel.LabCompletionSlug));
    private string LabStateLabel => ActiveLevel.IsAvailable
        ? IsLabCompleted ? T("Completed ✓", "Completado ✓") : T("Capstone →", "Integrador →")
        : T("Coming soon →", "Próximamente →");

    private ModuleStatus ModuleState(LearningLevelDefinition level, LearningModuleDefinition module)
    {
        if (module.Slugs.All(slug => Completed.Contains(LearningProgress.Entry(level.Key, slug)))) return ModuleStatus.Completed;
        if (level.IsAvailable && module.Slugs.All(slug => Reviewed.Contains(LearningProgress.Entry(level.Key, slug)))) return ModuleStatus.Reviewed;
        if (level.IsAvailable && module.Slugs.Any(slug =>
            Viewed.Contains(LearningProgress.Entry(level.Key, slug))
            || Reviewed.Contains(LearningProgress.Entry(level.Key, slug))
            || Completed.Contains(LearningProgress.Entry(level.Key, slug)))) return ModuleStatus.InProgress;
        return level.IsAvailable ? ModuleStatus.Pending : ModuleStatus.Upcoming;
    }

    private static string StateClass(ModuleStatus state) => state switch
    {
        ModuleStatus.Completed => "completed",
        ModuleStatus.Reviewed => "reviewed",
        ModuleStatus.InProgress => "in-progress",
        ModuleStatus.Upcoming => "upcoming",
        _ => "pending"
    };

    private string StateLabel(ModuleStatus state) => state switch
    {
        ModuleStatus.Completed => T("Completed", "Completado"),
        ModuleStatus.Reviewed => T("Reviewed", "Revisado"),
        ModuleStatus.InProgress => T("In progress", "En progreso"),
        ModuleStatus.Upcoming => T("Coming soon", "Próximamente"),
        _ => T("Pending", "Pendiente")
    };

    private static string ModuleRoute(LearningLevelDefinition level, LearningModuleDefinition module) => level.IsAvailable
        ? AppRoutes.LearnModule(level.Key, module.Slugs[0])
        : AppRoutes.ComingSoon(level.Key);
    private enum ModuleStatus { Pending, InProgress, Reviewed, Completed, Upcoming }
}
