@page "/aprender/{Level}/{TopicSlug?}"
@page "/learn/{Level}/{TopicSlug?}"
@using DotnetCodeMaturityLab.Components.Learning
@using DotnetCodeMaturityLab.Features.Learning
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageTitle>@CurrentMetadata.Title | @LevelContent.Definition.Label</PageTitle>

<div class="course-player learning-module-shell learning-course-player">
    <aside class="course-curriculum @(CurriculumOpen ? "open" : null)" aria-label="@T("Level content", "Contenido del nivel")">
        <header>
            <div>
                <span class="eyebrow">@T("Learning path", "Ruta de aprendizaje")</span>
                <h2>@LevelContent.Definition.Label</h2>
                <p>@LevelContent.Description.Get(Language.Current)</p>
            </div>
            <button type="button" class="curriculum-toggle" @onclick="ToggleCurriculum" aria-expanded="@CurriculumOpen" aria-label="@T("Show or hide modules", "Mostrar u ocultar módulos")">
                <span>@(CurriculumOpen ? T("Hide", "Ocultar") : T("View modules", "Ver módulos"))</span><b aria-hidden="true">⌄</b>
            </button>
        </header>

        <div class="curriculum-progress" aria-label="@T("Level progress", "Progreso del nivel")">
            <div><span>@T("Your progress", "Tu progreso")</span><strong>@AvailableCompleted @T("of", "de") @AvailableTopicCount @T("available", "disponibles")</strong></div>
            <div><span style="width: @AvailableProgressPercent%"></span></div>
            <small>@AvailableProgressPercent% @T("completed", "completado")</small>
        </div>
        <div class="curriculum-status-key" aria-label="@T("Status meaning", "Significado de los estados")">
            <span><b>◌</b> @T("Viewed", "Visto")</span>
            <span><b>◉</b> @T("Reviewed", "Revisado")</span>
            <span><b>✓</b> @T("Completed", "Completado")</span>
        </div>

        <nav>
            @for (var index = 0; index < Topics.Count; index++)
            {
                var topicIndex = index;
                var topic = Topics[index];
                @if (index == 0 || !TopicBlock(Topics[index - 1]).Equals(TopicBlock(topic), StringComparison.Ordinal))
                {
                    <span class="curriculum-group">@TopicBlock(topic)</span>
                }
                <button type="button" class="@TopicClass(topic, index)" @onclick="() => SelectTopic(topicIndex)" aria-current="@(index == ActiveTopicIndex ? "page" : null)">
                    <span class="curriculum-state">@TopicStateIcon(topic, index)</span>
                    <span>
                        <small>@T("Module", "Módulo") @(index + 1)</small>
                        @TopicShortTitle(topic)
                        @if (index >= AvailableTopicCount)
                        {
                            <em>@T("Under maintenance", "En mantenimiento")</em>
                        }
                    </span>
                    <i aria-hidden="true">›</i>
                </button>
            }
        </nav>
        <a class="course-lab-link" href="@LevelContent.Definition.LabRoute"><span>@T("Level laboratory", "Laboratorio del nivel")</span><strong>@LevelContent.Definition.LabTitle.Get(Language.Current) →</strong></a>
    </aside>

    <main class="course-stage @(IsMaintenance ? "maintenance" : null)" aria-labelledby="lesson-title">
        <header class="course-header">
            <div>
                <a class="course-back" href="@AppRoutes.Roadmap">← @T("Maturity roadmap", "Ruta de madurez")</a>
                <span class="eyebrow">@LevelContent.Definition.Label · @T("Module", "Módulo") @((ActiveTopicIndex + 1).ToString("00"))</span>
                <h1 id="lesson-title">@CurrentMetadata.Title</h1>
            </div>
        </header>

        @if (IsMaintenance)
        {
            <section class="course-maintenance-panel">
                <div class="maintenance-symbol" aria-hidden="true">⌁</div>
                <span class="step-label">@T("Protected content", "Contenido protegido")</span>
                <h2>@T("This module will resume after validating the first two.", "Este módulo se retomará después de validar los dos primeros.")</h2>
                <p>@T("Its content remains saved. We are refining the Fundamentals and Methods and classes experiences before replicating the format.", "Su contenido permanece guardado. Por ahora estamos afinando la experiencia de Fundamentos y Métodos y clases antes de replicar el formato.")</p>
                <button type="button" class="button button-primary" @onclick="OpenFirstModule">@T("Open module 1", "Abrir módulo 1") →</button>
            </section>
        }
        else
        {
            <nav class="course-perspectives" role="tablist" aria-label="@T("Module perspectives", "Perspectivas del módulo")">
                @for (var index = 0; index < PerspectiveNames.Length; index++)
                {
                    var perspectiveIndex = index;
                    <button type="button" role="tab" class="@(ActivePerspective == index ? "active" : null)" aria-selected="@(ActivePerspective == index ? "true" : "false")" @onclick="() => SelectPerspective(perspectiveIndex)">
                        <span>@(index + 1).</span> @PerspectiveNames[index]
                    </button>
                }
            </nav>

            <section class="course-perspective module-one-perspective code-first-panel" role="tabpanel" @key="ActivePerspective">
                <button type="button" class="hint-lamp" @onclick="OpenHint" aria-label="@T("Open hint for", "Abrir pista de") @PerspectiveNames[ActivePerspective]">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21h6m-5-3h4m-7-7a5 5 0 1 1 10 0c0 2-1.1 3.2-2.2 4.3-.5.5-.8 1.1-.8 1.7h-4c0-.6-.3-1.2-.8-1.7C8.1 14.2 7 13 7 11Z"/></svg>
                </button>

                <header class="code-scene-header"><span class="step-label">@CurrentCatalogStep.Label</span><p>@CurrentCatalogStep.Caption</p></header>

                @if (CurrentCatalogStep.Right is null)
                {
                    <CSharpCodeWindow FileName="@CurrentCatalogStep.Left.FileName" Label="@CurrentCatalogStep.Left.Label" CssClass="@CurrentCatalogStep.Left.CssClass" PlainCode="@CurrentCatalogStep.Left.Code" />
                }
                else
                {
                    <div class="code-compare-grid lesson-dual-code @(ActivePerspective == PerspectiveNames.Length - 1 ? "final-code-review" : null)">
                        <CSharpCodeWindow FileName="@CurrentCatalogStep.Left.FileName" Label="@CurrentCatalogStep.Left.Label" CssClass="@($"{CurrentCatalogStep.Left.CssClass} review-code")" PlainCode="@CurrentCatalogStep.Left.Code" />
                        <CSharpCodeWindow FileName="@CurrentCatalogStep.Right.FileName" Label="@CurrentCatalogStep.Right.Label" CssClass="@($"{CurrentCatalogStep.Right.CssClass} review-code")" PlainCode="@CurrentCatalogStep.Right.Code" />
                    </div>
                }
            </section>

            @if (HintOpen)
            {
                <div class="hint-modal-backdrop" role="presentation" @onclick="CloseHint" @onkeydown="HandleHintKey" tabindex="-1">
                    <section class="hint-modal" role="dialog" aria-modal="true" aria-labelledby="hint-title" @onclick:stopPropagation="true">
                        <header class="hint-modal-header">
                            <div class="hint-modal-heading">
                                <div class="hint-modal-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 21h6m-5-3h4m-7-7a5 5 0 1 1 10 0c0 2-1.1 3.2-2.2 4.3-.5.5-.8 1.1-.8 1.7h-4c0-.6-.3-1.2-.8-1.7C8.1 14.2 7 13 7 11Z"/></svg></div>
                                <span class="eyebrow">@T("Step hint", "Pista del paso")</span>
                            </div>
                            <button type="button" class="hint-modal-close" @onclick="CloseHint" aria-label="@T("Close hint", "Cerrar pista")">×</button>
                        </header>
                        <div class="hint-modal-body">
                            <h2 id="hint-title">@HintTitle</h2>
                            <p>@HintBody</p>
                            <code>@HintExample</code>
                        </div>
                    </section>
                </div>
            }

            <footer class="course-navigation">
                <button type="button" @onclick="GoPreviousStep" disabled="@(ActivePerspective == 0)">← <span><small>@T("Previous", "Anterior")</small>@PreviousStepLabel</span></button>
                <div class="course-position" aria-label="@T("Progress within the module", "Progreso dentro del módulo")">
                    @for (var index = 0; index < PerspectiveNames.Length; index++)
                    {
                        var perspectiveIndex = index;
                        <button type="button" class="@(ActivePerspective == index ? "active" : ActivePerspective > index ? "visited" : null)" @onclick="() => SelectPerspective(perspectiveIndex)" aria-label="@T("Go to", "Ir a") @PerspectiveNames[index]"></button>
                    }
                </div>
                <button type="button" class="next" @onclick="GoNextStep"><span><small>@NextActionLabel</small>@NextStepLabel</span> →</button>
            </footer>
        }
    </main>
</div>

@code {
    [Parameter] public string Level { get; set; } = "junior";
    [Parameter] public string? TopicSlug { get; set; }

    private int ActiveTopicIndex { get; set; }
    private int ActivePerspective { get; set; }
    private bool CurriculumOpen { get; set; }
    private bool ProgressLoaded { get; set; }
    private LearningProgressState ProgressSnapshot { get; set; } = LearningProgress.Empty;
    private bool HintOpen { get; set; }
    private HashSet<string> Viewed { get; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> Reviewed { get; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> Completed { get; } = new(StringComparer.OrdinalIgnoreCase);
    // Navigation to a coming-soon route can complete after one final render.
    // The fallback prevents an unavailable level from throwing during that transition.
    private LearningLevelContent LevelContent =>
        LearningContentCatalog.TryGet(Level, Language.Current, out var content)
            ? content
            : LearningContentCatalog.Get("junior", Language.Current);
    private IReadOnlyList<LearningModuleContent> Modules => LevelContent.Modules;
    private IReadOnlyList<LabTopic> Topics => Modules.Select(module => module.Topic).ToArray();
    private LearningModuleContent CurrentModule => Modules[ActiveTopicIndex];
    private LabTopic CurrentTopic => CurrentModule.Topic;
    private ModuleMetadata CurrentMetadata => CurrentModule.Metadata;
    private int AvailableTopicCount => Topics.Count;
    private ModuleLesson CurrentCatalogModule => CurrentModule.Lesson;
    private LessonPerspective CurrentCatalogStep => CurrentCatalogModule.Steps[ActivePerspective];
    private string[] PerspectiveNames => CurrentCatalogModule.Steps.Select(step => step.Name).ToArray();
    private bool IsMaintenance => ActiveTopicIndex >= AvailableTopicCount;
    private int AvailableCompleted => Topics.Take(AvailableTopicCount).Count(topic => Completed.Contains(topic.Slug));
    private int AvailableProgressPercent => AvailableCompleted * 100 / AvailableTopicCount;
    private bool IsCurrentModuleCompleted => Completed.Contains(CurrentTopic.Slug);
    private string PreviousStepLabel => ActivePerspective > 0 ? PerspectiveNames[ActivePerspective - 1] : T("Roadmap", "Ruta");
    private string NextStepLabel => ActivePerspective < PerspectiveNames.Length - 1
        ? PerspectiveNames[ActivePerspective + 1]
        : !IsCurrentModuleCompleted ? T("Complete module", "Completar módulo")
        : ActiveTopicIndex < AvailableTopicCount - 1 ? TopicShortTitle(Topics[ActiveTopicIndex + 1]) : T("Maturity roadmap", "Ruta de madurez");
    private string NextActionLabel => ActivePerspective < PerspectiveNames.Length - 1
        ? T("Next", "Siguiente")
        : !IsCurrentModuleCompleted ? T("Confirm review", "Confirmar revisión") : T("Next", "Siguiente");
    private string HintTitle => CurrentCatalogStep.HintTitle;
    private string HintBody => CurrentCatalogStep.HintBody;
    private string HintExample => CurrentCatalogStep.HintExample;
    private ModuleMetadata MetadataFor(LabTopic topic) => Modules.First(module => module.Topic.Slug.Equals(topic.Slug, StringComparison.OrdinalIgnoreCase)).Metadata;
    private string TopicShortTitle(LabTopic topic) => MetadataFor(topic).ShortTitle;
    private string TopicBlock(LabTopic topic) => MetadataFor(topic).Block;

    protected override void OnParametersSet()
    {
        if (!LearningContentCatalog.TryGet(Level, Language.Current, out _)) { Navigation.NavigateTo(AppRoutes.ComingSoon(Level)); return; }

        var internalSlug = string.IsNullOrWhiteSpace(TopicSlug)
            ? Topics[0].Slug
            : AppRoutes.InternalModuleSlug(Level, TopicSlug);
        ActiveTopicIndex = IndexOf(internalSlug);
        if (ActiveTopicIndex < 0) ActiveTopicIndex = 0;

        ActivePerspective = 0;
        CurriculumOpen = false;
        HintOpen = false;
        if (ProgressLoaded && !IsMaintenance) MarkViewed();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var stored = await JS.InvokeAsync<LearningProgressState?>("labProgress.get", LearningProgress.StorageKey);
        ProgressSnapshot = LearningProgress.Migrate(stored);
        Viewed.UnionWith(LearningProgress.ForLevel(ProgressSnapshot.Viewed, Level));
        Reviewed.UnionWith(LearningProgress.ForLevel(ProgressSnapshot.Reviewed, Level));
        Completed.UnionWith(LearningProgress.ForLevel(ProgressSnapshot.Completed, Level));

        ProgressLoaded = true;
        if (!IsMaintenance) MarkViewed();
        await PersistProgress();
        StateHasChanged();
    }

    private int IndexOf(string slug) { for (var index = 0; index < Topics.Count; index++) if (Topics[index].Slug.Equals(slug, StringComparison.OrdinalIgnoreCase)) return index; return -1; }
    private void SelectTopic(int index) => Navigation.NavigateTo(AppRoutes.LearnModule(Level, Topics[index].Slug));
    private void OpenFirstModule() => SelectTopic(0);
    private void SelectPerspective(int index) { ActivePerspective = index; HintOpen = false; if (index == PerspectiveNames.Length - 1) MarkReviewed(); }
    private void ToggleCurriculum() => CurriculumOpen = !CurriculumOpen;
    private void GoPreviousStep() { if (ActivePerspective > 0) ActivePerspective--; HintOpen = false; }
    private void GoNextStep()
    {
        if (ActivePerspective < PerspectiveNames.Length - 1)
        {
            ActivePerspective++;
            if (ActivePerspective == PerspectiveNames.Length - 1) MarkReviewed();
        }
        else if (!IsCurrentModuleCompleted)
        {
            CompleteAvailableModule();
        }
        else if (ActiveTopicIndex < AvailableTopicCount - 1)
        {
            SelectTopic(ActiveTopicIndex + 1);
        }
        else
        {
            Navigation.NavigateTo(AppRoutes.Roadmap);
        }

        HintOpen = false;
    }
    private void OpenHint() => HintOpen = true;
    private void CloseHint() => HintOpen = false;
    private void HandleHintKey(KeyboardEventArgs args) { if (args.Key == "Escape") CloseHint(); }
    private void CompleteAvailableModule() { MarkViewed(); if (Completed.Add(CurrentTopic.Slug)) _ = PersistProgress(); }
    private void MarkReviewed() { MarkViewed(); if (Reviewed.Add(CurrentTopic.Slug)) _ = PersistProgress(); }
    private string TopicClass(LabTopic topic, int index) => index >= AvailableTopicCount
        ? index == ActiveTopicIndex ? "maintenance active" : "maintenance"
        : topic.Slug.Equals(CurrentTopic.Slug, StringComparison.OrdinalIgnoreCase) ? "active"
        : Completed.Contains(topic.Slug) ? "completed"
        : Reviewed.Contains(topic.Slug) ? "reviewed"
        : Viewed.Contains(topic.Slug) ? "viewed"
        : string.Empty;
    private string TopicStateIcon(LabTopic topic, int index) => index >= AvailableTopicCount ? "–"
        : topic.Slug.Equals(CurrentTopic.Slug, StringComparison.OrdinalIgnoreCase) ? "●"
        : Completed.Contains(topic.Slug) ? "✓"
        : Reviewed.Contains(topic.Slug) ? "◉"
        : Viewed.Contains(topic.Slug) ? "◌"
        : "○";
    private void MarkViewed() { if (!IsMaintenance && Viewed.Add(CurrentTopic.Slug)) _ = PersistProgress(); }
    private async Task PersistProgress()
    {
        if (!ProgressLoaded) return;
        ProgressSnapshot = LearningProgress.WithLevel(ProgressSnapshot, Level, Viewed, Reviewed, Completed);
        await JS.InvokeVoidAsync("labProgress.set", LearningProgress.StorageKey, ProgressSnapshot);
    }
}
