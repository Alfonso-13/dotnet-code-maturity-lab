@page "/historia-dotnet"
@using DotnetCodeMaturityLab.Components.Learning

<PageTitle>Historia de .NET | .NET Code Maturity Lab</PageTitle>

<header class="history-hero">
    <div>
        <span class="eyebrow">Historia de .NET</span>
        <h1>Una plataforma que cambió para llegar a más lugares.</h1>
        <p>.NET no reemplazó una versión con otra siguiendo una sola línea. Se abrió en ramas: una permaneció ligada a Windows, otra hizo la plataforma multiplataforma y ambas ideas convergieron en el .NET moderno.</p>
        <div class="button-row"><a class="button button-secondary" href="ecosistema-dotnet">¿Qué tecnología usar hoy? <span aria-hidden="true">→</span></a></div>
    </div>
</header>

<section class="history-map" aria-labelledby="history-map-title">
    <header class="history-map-heading">
        <div>
            <span class="eyebrow">Mapa de evolución</span>
            <h2 id="history-map-title">Del CLR original a una plataforma unificada</h2>
        </div>
        <div class="history-map-context">
            <aside class="history-now" aria-label="Punto actual de la cronología">
                <span>Punto actual · noviembre 2026</span>
                <strong>.NET 11</strong>
                <small>Plataforma unificada, abierta y multiplataforma.</small>
            </aside>
            <div class="history-legend" aria-label="Leyenda">
                <span><i class="framework"></i> Windows</span>
                <span><i class="core"></i> Multiplataforma</span>
                <span><i class="modern"></i> Unificado</span>
            </div>
        </div>
    </header>

    <div class="history-track-headings" aria-label="Ramas de la cronología">
        <span class="history-year-heading">Año</span>
        <div class="framework"><span class="history-logo-frame"><img class="history-platform-logo" src="images/dotnet-framework-logo.png" alt="Microsoft .NET Framework" /></span><span><small>Rama Windows</small><strong>.NET Framework</strong></span></div>
        <div class="core"><span class="history-logo-frame"><img class="history-platform-logo" src="images/dotnet-core-logo.png" alt=".NET Core" /></span><span><small>Rama abierta</small><strong>.NET Core</strong></span></div>
        <div class="modern"><span class="history-logo-frame"><img class="history-platform-logo" src="images/dotnet-modern-logo.png" alt=".NET" /></span><span><small>Convergencia</small><strong>.NET moderno</strong></span></div>
    </div>

    <div class="history-chronology">
        <span class="history-progress-line" aria-hidden="true"></span>
        @foreach (var row in HistoryRows)
        {
            <section class="history-year-row" aria-label="Versiones publicadas en @row.Year">
                <time datetime="@row.Year"><span>@row.Year</span></time>
                @if (row.Framework is not null) { <span class="history-row-link framework" aria-hidden="true"></span> }
                @if (row.Core is not null) { <span class="history-row-link core" aria-hidden="true"></span> }
                @if (row.Modern is not null) { <span class="history-row-link modern" aria-hidden="true"></span> }
                <div class="history-track-cell framework">
                    @if (row.Framework is not null)
                    {
                        <HistoryMilestone Item="row.Framework" Branch="framework" />
                    }
                </div>
                <div class="history-track-cell core">
                    @if (row.Core is not null)
                    {
                        <HistoryMilestone Item="row.Core" Branch="core" />
                    }
                </div>
                <div class="history-track-cell modern">
                    @if (row.Modern is not null)
                    {
                        <HistoryMilestone Item="row.Modern" Branch="modern" />
                    }
                </div>
            </section>
        }
    </div>

    <footer class="history-branch-summary">
        <article class="framework"><strong>Framework continúa</strong><span>para aplicaciones Windows existentes.</span></article>
        <article class="core"><strong>Core converge</strong><span>sus ideas pasan a la plataforma principal desde .NET 5.</span></article>
        <article class="modern"><strong>.NET 11 es actual</strong><span>.NET 10 LTS es la base de este laboratorio.</span></article>
    </footer>
</section>

<aside class="history-next-step">
    <div><span class="eyebrow">Del pasado a la decisión</span><strong>Ahora elige qué parte de .NET necesita tu proyecto.</strong></div>
    <a class="button button-primary" href="ecosistema-dotnet">Explorar el ecosistema .NET <span aria-hidden="true">→</span></a>
</aside>

