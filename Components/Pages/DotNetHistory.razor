@page "/historia-dotnet"
@page "/dotnet-history"
@using DotnetCodeMaturityLab.Components.Learning
@inherits LocalizedComponentBase

<PageTitle>@T(".NET history", "Historia de .NET") | .NET Code Maturity Lab</PageTitle>

<header class="history-hero">
    <div>
        <span class="eyebrow">@T(".NET history", "Historia de .NET")</span>
        <h1>@T("A platform that changed to reach more places.", "Una plataforma que cambió para llegar a más lugares.")</h1>
        <p>@T(".NET did not replace one version with another along a single line. It branched: one path remained tied to Windows, another made the platform cross-platform, and both ideas converged in modern .NET.", ".NET no reemplazó una versión con otra siguiendo una sola línea. Se abrió en ramas: una permaneció ligada a Windows, otra hizo la plataforma multiplataforma y ambas ideas convergieron en el .NET moderno.")</p>
        <div class="button-row"><a class="button button-secondary" href="@AppRoutes.DotNetEcosystem">@T("Which technology should you use today?", "¿Qué tecnología usar hoy?") <span aria-hidden="true">→</span></a></div>
    </div>
</header>

<section class="history-map" aria-labelledby="history-map-title">
    <header class="history-map-heading">
        <div>
            <span class="eyebrow">@T("Evolution map", "Mapa de evolución")</span>
            <h2 id="history-map-title">@T("From the original CLR to a unified platform", "Del CLR original a una plataforma unificada")</h2>
        </div>
        <div class="history-map-context">
            <aside class="history-now" aria-label="@T("Current point in the timeline", "Punto actual de la cronología")">
                <span>@T("Current point · November 2026", "Punto actual · noviembre 2026")</span>
                <strong>.NET 11</strong>
                <small>@T("Unified, open, cross-platform.", "Plataforma unificada, abierta y multiplataforma.")</small>
            </aside>
            <div class="history-legend" aria-label="@T("Legend", "Leyenda")">
                <span><i class="framework"></i> Windows</span>
                <span><i class="core"></i> @T("Cross-platform", "Multiplataforma")</span>
                <span><i class="modern"></i> @T("Unified", "Unificado")</span>
            </div>
        </div>
    </header>

    <div class="history-track-headings" aria-label="@T("Timeline branches", "Ramas de la cronología")">
        <span class="history-year-heading">@T("Year", "Año")</span>
        <div class="framework"><span class="history-logo-frame"><img class="history-platform-logo" src="images/dotnet-framework-logo.png" alt="Microsoft .NET Framework" /></span><span><small>@T("Windows branch", "Rama Windows")</small><strong>.NET Framework</strong></span></div>
        <div class="core"><span class="history-logo-frame"><img class="history-platform-logo" src="images/dotnet-core-logo.png" alt=".NET Core" /></span><span><small>@T("Open branch", "Rama abierta")</small><strong>.NET Core</strong></span></div>
        <div class="modern"><span class="history-logo-frame"><img class="history-platform-logo" src="images/dotnet-modern-logo.png" alt=".NET" /></span><span><small>@T("Convergence", "Convergencia")</small><strong>@T("Modern .NET", ".NET moderno")</strong></span></div>
    </div>

    <div class="history-chronology">
        <span class="history-progress-line" aria-hidden="true"></span>
        @foreach (var row in HistoryRows)
        {
            <section class="history-year-row" aria-label="@T("Versions released in", "Versiones publicadas en") @row.Year">
                <time datetime="@row.Year"><span>@row.Year</span></time>
                @if (row.Framework is not null) { <span class="history-row-link framework" aria-hidden="true"></span> }
                @if (row.Core is not null) { <span class="history-row-link core" aria-hidden="true"></span> }
                @if (row.Modern is not null) { <span class="history-row-link modern" aria-hidden="true"></span> }
                <div class="history-track-cell framework">
                    @if (row.Framework is not null)
                    {
                        <HistoryMilestone Item="row.Framework" Branch="framework" />
                    }
                </div>
                <div class="history-track-cell core">
                    @if (row.Core is not null)
                    {
                        <HistoryMilestone Item="row.Core" Branch="core" />
                    }
                </div>
                <div class="history-track-cell modern">
                    @if (row.Modern is not null)
                    {
                        <HistoryMilestone Item="row.Modern" Branch="modern" />
                    }
                </div>
            </section>
        }
    </div>

    <footer class="history-branch-summary">
        <article class="framework"><strong>@T("Framework continues", "Framework continúa")</strong><span>@T("for existing Windows applications.", "para aplicaciones Windows existentes.")</span></article>
        <article class="core"><strong>@T("Core converges", "Core converge")</strong><span>@T("its ideas move into the main platform starting with .NET 5.", "sus ideas pasan a la plataforma principal desde .NET 5.")</span></article>
        <article class="modern"><strong>@T(".NET 11 is current", ".NET 11 es actual")</strong><span>@T(".NET 10 LTS is the foundation of this laboratory.", ".NET 10 LTS es la base de este laboratorio.")</span></article>
    </footer>
</section>

<aside class="history-next-step">
    <div><span class="eyebrow">@T("From the past to the decision", "Del pasado a la decisión")</span><strong>@T("Now choose which part of .NET your project needs.", "Ahora elige qué parte de .NET necesita tu proyecto.")</strong></div>
    <a class="button button-primary" href="@AppRoutes.DotNetEcosystem">@T("Explore the .NET ecosystem", "Explorar el ecosistema .NET") <span aria-hidden="true">→</span></a>
</aside>

