<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@SiteSeo.Title</title>
    <meta name="description" content="@SiteSeo.Description" />
    <meta name="author" content="@SiteSeo.Author" />
    <meta name="application-name" content="@SiteSeo.SiteName" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="@SiteSeo.PublicUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteSeo.SiteName" />
    <meta property="og:locale" content="@SiteSeo.Locale" />
    <meta property="og:url" content="@SiteSeo.PublicUrl" />
    <meta property="og:title" content="@SiteSeo.Title" />
    <meta property="og:description" content="@SiteSeo.Description" />
    <meta property="og:image" content="@SiteSeo.SocialImageUrl" />
    <meta property="og:image:secure_url" content="@SiteSeo.SocialImageUrl" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="@SiteSeo.SocialImageWidth" />
    <meta property="og:image:height" content="@SiteSeo.SocialImageHeight" />
    <meta property="og:image:alt" content="@SiteSeo.SocialImageAlt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SiteSeo.Title" />
    <meta name="twitter:description" content="@SiteSeo.Description" />
    <meta name="twitter:image" content="@SiteSeo.SocialImageUrl" />
    <meta name="twitter:image:alt" content="@SiteSeo.SocialImageAlt" />
    <meta name="theme-color" content="@SiteSeo.ThemeColor" />
    <link rel="icon" type="image/png" href="images/dotnet-code-maturity-lab-icon.png" />
    <link rel="apple-touch-icon" href="images/dotnet-code-maturity-lab-icon.png" />
    <link rel="manifest" href="site.webmanifest" />
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "name": ".NET Code Maturity Lab",
          "url": "https://alfonso-13.github.io/dotnet-code-maturity-lab/",
          "description": "Learn .NET visually through code comparisons, tests, interview practice, and real engineering decisions from Junior to Senior.",
          "inLanguage": ["en", "es"],
          "author": {
            "@@type": "Person",
            "name": "Alfonso-13",
            "url": "https://github.com/Alfonso-13"
          }
        }
    </script>
    <script>
        try {
            if (window.sessionStorage.getItem("dotnet-code-maturity-intro-seen") === "true") {
                document.documentElement.classList.add("intro-seen");
            }
        } catch { }
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DotnetCodeMaturityLab.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <div id="site-intro" class="site-intro" aria-hidden="true" data-permanent>
        <div class="intro-accent"></div>
        <div class="intro-content">
            <span class="intro-kicker">Red &amp; Black Codeworkers presents</span>
            <div class="intro-mark">
                <span class="intro-tile intro-tile-red">&lt;</span>
                <span class="intro-tile intro-tile-dark">&gt;</span>
            </div>
            <div class="intro-wordmark">
                <strong><span>Red</span> &amp; Black</strong>
                <small>Codeworkers</small>
            </div>
            <div class="intro-product">
                <span></span>
                <p>.NET Code Maturity Lab</p>
                <span></span>
            </div>
            <div class="intro-loading">
                <i></i>
                <small>Preparing the laboratory</small>
            </div>
        </div>
    </div>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["intro.js"]"></script>
    <script src="@Assets["lab-progress.js"]"></script>
    <script src="@Assets["section-reveal.js"]"></script>
    <script src="@Assets["history-timeline.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        const registerEnhancedLoad = () => {
            if (!window.Blazor) {
                window.setTimeout(registerEnhancedLoad, 50);
                return;
            }

            window.Blazor.addEventListener("enhancedload", () => {
                window.dotnetIntro?.hideIfSeen();
                window.sectionReveal?.scan();
                window.dotnetHistoryTimeline?.scan();
            });
        };

        registerEnhancedLoad();
    </script>
</body>

</html>
