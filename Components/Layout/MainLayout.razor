@inherits LayoutComponentBase

@using DotnetCodeMaturityLab.Features.Configuration
@inject AppLanguageState Language
@inject IJSRuntime JS
@inject SiteOptions Site

<a class="skip-link" href="#main-content">@Text.SkipToContent</a>

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="" aria-label="@Text.HomeAriaLabel">
            <img class="brand-app-icon" src="images/dotnet-code-maturity-lab-icon.png" alt="" />
            <span class="brand-product">
                <strong>@Site.ProductName</strong>
                <small>@Text.ProductTagline</small>
            </span>
        </a>
        <div class="topbar-actions">
            <div class="language-switch" role="group" aria-label="@Text.LanguageLabel">
                <button type="button" class="@(Language.Code == "en" ? "active" : null)" aria-pressed="@(Language.Code == "en")" @onclick='() => SelectLanguage("en")'>EN</button>
                <span aria-hidden="true">|</span>
                <button type="button" class="@(Language.Code == "es" ? "active" : null)" aria-pressed="@(Language.Code == "es")" @onclick='() => SelectLanguage("es")'>ES</button>
            </div>
            <span class="public-badge"><span aria-hidden="true">●</span> @Text.OpenLab</span>
            <a class="github-link" href="@Site.GitHubUrl" target="_blank" rel="noreferrer">@Text.ViewOnGitHub <span aria-hidden="true">↗</span></a>
        </div>
    </header>
    <aside class="sidebar" aria-label="@Text.MainNavigation"><NavMenu Text="@Text" /></aside>
    <main id="main-content" class="main-content" tabindex="-1">
        <CascadingValue Value="Language">@Body</CascadingValue>
    </main>
    <footer class="app-footer">
        <span>@Text.EducationalProjectBy <strong>@Site.OwnerName</strong></span>
        <span>@Text.BuiltWith</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Text.UnexpectedError
    <a href="." class="reload">@Text.Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private UiText Text => Language.Text;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var storedLanguage = await JS.InvokeAsync<string?>("uiLanguage.get", AppLanguageState.StorageKey);
        if (Language.Set(storedLanguage)) StateHasChanged();
        await JS.InvokeVoidAsync("uiLanguage.apply", Language.Code);
    }

    private async Task SelectLanguage(string languageCode)
    {
        Language.Set(languageCode);
        await JS.InvokeVoidAsync("uiLanguage.set", AppLanguageState.StorageKey, Language.Code);
        StateHasChanged();
    }
}
